# Copy this file to .env.local and fill it in. .env.local is gitignored.
# Verify the database with:  npm run db:ping

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string.
# Atlas → Database → Connect → Drivers. Add the database name before the "?".
# Lock Network Access to your deploy IPs and give the user access to this DB only.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/dampeak?retryWrites=true&w=majority"

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin. Used by canonical tags, the sitemap and OG metadata.
# Until this is set, canonical URLs resolve against http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://dampeak.com"

# ── Google sign-in ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#   Application type:        Web application
#   Authorised origins:      http://localhost:3000  and  https://dampeak.com
#   Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#                            https://dampeak.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
# Same value as GOOGLE_CLIENT_ID, exposed to the browser so Google One Tap can
# run in the page. A client ID is public by design — it appears in every OAuth
# URL. The SECRET below must never be given the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

GOOGLE_CLIENT_SECRET=""

# Signs and encrypts session cookies. Generate one with:  openssl rand -base64 32
# Changing it logs everybody out.
AUTH_SECRET=""

# Comma-separated addresses allowed into /admin. Everything else that signs in is
# an ordinary customer.
#
# This is not optional. Google sign-in by itself admits anyone with a Google
# account — without an allowlist, the admin area is open to the entire internet.
ADMIN_EMAILS="you@example.com"
